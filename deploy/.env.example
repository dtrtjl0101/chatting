# Create a remotely managed Cloudflare Tunnel and copy its token here.
CLOUDFLARE_TUNNEL_TOKEN=

# Generate separate long random passwords for MySQL app user and root. Keep private.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Separate credentials for local/test database, not used by production services.
MYSQL_TEST_PASSWORD=
MYSQL_TEST_ROOT_PASSWORD=

# OAuth callback URLs: https://<your-host>/login/oauth2/code/google or /kakao
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
APP_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:*,https://chatting.ljbhomeserver.date
